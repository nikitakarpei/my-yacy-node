#!/bin/sh
# Download the pinned tools from their official releases into .toolchain,
# verifying each archive against tools/tools.lock.
# Without arguments it installs every group pinned for this platform. The group
# `verify` holds the tools that make verify needs, and `android` the toolchain
# of the Android apps. Named tools install only those. After each group, the
# toolchain keeps a copy of tools.lock, so the Makefile can tell when the
# installed tools of the group are out of date; `--check <group>` tells.
# No `go install` / `go tool`: nothing is compiled and the project module
# graph is untouched.
set -eu

root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
lock="$root/tools/tools.lock"
toolchain="$root/.toolchain"
bin="$toolchain/bin"
goroot="$toolchain/go"

pins() { grep -v '^#' "$lock"; }

# `--check <group>` prints nothing when the group is installed at the pins of
# tools.lock, and prints why not, with status 1, otherwise.
if [ "${1:-}" = --check ]; then
	group="${2:-}"
	case "$group" in
		verify | android) ;;
		*) echo "usage: tools/install --check verify|android" >&2; exit 2 ;;
	esac
	if ! pins | cmp -s - "$toolchain/installed-$group.lock" 2>/dev/null; then
		echo "The $group tools are missing or out of date. Run ./tools/install $group"
		exit 1
	fi
	exit 0
fi

case "$(uname -s)" in
	Linux) os=linux ;;
	Darwin) os=darwin ;;
	*) echo "unsupported OS: $(uname -s)" >&2; exit 1 ;;
esac
case "$(uname -m)" in
	x86_64 | amd64) arch=amd64 ;;
	aarch64 | arm64) arch=arm64 ;;
	*) echo "unsupported architecture: $(uname -m)" >&2; exit 1 ;;
esac
platform="$os-$arch"
verify_tools="go golangci-lint go-arch-lint ruff uv mado esbuild biome zig"
android_tools="jdk android-platform android-build-tools android-platform-tools android-ndk"
groups=
case "$*" in
	"")
		groups=verify
		if [ -n "$(awk -v plat="$platform" '$1 == "android-ndk" && $3 == plat' "$lock")" ]; then
			groups="verify android"
		else
			echo "==> android skipped: no Android SDK packages are pinned for $platform"
		fi
		;;
	verify | android | "verify android" | "android verify") groups="$*" ;;
esac
if [ -n "$groups" ]; then
	set --
	for group in $groups; do
		case "$group" in
			verify) set -- "$@" $verify_tools ;;
			android) set -- "$@" $android_tools ;;
		esac
	done
fi
requested=" $* "

wanted() {
	case "$requested" in
		*" $1 "*) return 0 ;;
	esac
	return 1
}

lookup() {
	awk -v tool="$1" -v plat="$platform" \
		'$1 == tool && $3 == plat { print $2, $4, $5 }' "$lock"
}

sha256() {
	if command -v sha256sum >/dev/null 2>&1; then
		sha256sum "$1" | cut -d' ' -f1
	else
		shasum -a 256 "$1" | cut -d' ' -f1
	fi
}

fetch() {
	tool="$1"; url="$2"; want="$3"; member="$4"
	tmp=$(mktemp -d)
	trap 'rm -rf "$tmp"' EXIT
	echo "==> $tool $platform"
	curl -fsSL "$url" -o "$tmp/archive.tar.gz"
	got=$(sha256 "$tmp/archive.tar.gz")
	if [ "$got" != "$want" ]; then
		echo "checksum mismatch for $tool: expected $want, got $got" >&2
		exit 1
	fi
	tar -xzf "$tmp/archive.tar.gz" -C "$tmp"
	install -m 0755 "$tmp/$member" "$bin/$tool"
	rm -rf "$tmp"
	trap - EXIT
}

# Go, Zig and the JDK ship as trees, not one binary; each archive carries its tree under
# one top directory. GOROOT is the Go tree at .toolchain/go.
fetch_tree() {
	tool="$1"; url="$2"; want="$3"; tree="$4"
	tmp=$(mktemp -d)
	trap 'rm -rf "$tmp"' EXIT
	echo "==> $tool $platform"
	curl -fsSL "$url" -o "$tmp/archive"
	got=$(sha256 "$tmp/archive")
	if [ "$got" != "$want" ]; then
		echo "checksum mismatch for $tool: expected $want, got $got" >&2
		exit 1
	fi
	rm -rf "$tree"
	mkdir -p "$tree"
	tar -xf "$tmp/archive" -C "$tree" --strip-components=1
	rm -rf "$tmp"
	trap - EXIT
}

# Shells reach the toolchain through `. .toolchain/activate`, which points GOROOT,
# JAVA_HOME and ANDROID_HOME at the pinned trees and keeps every cache, the uv-managed
# Python and the Gradle distribution inside .toolchain.
write_activate() {
	cat > "$toolchain/activate" <<'EOF'
# Source this: . .toolchain/activate
TOOLCHAIN_DIR="$(cd "$(dirname "${BASH_SOURCE[0]:-$0}")" && pwd)"
export TOOLCHAIN_DIR
export GOROOT="$TOOLCHAIN_DIR/go"
export GOPATH="$TOOLCHAIN_DIR/gopath"
export GOCACHE="$TOOLCHAIN_DIR/gocache"
export GOMODCACHE="$TOOLCHAIN_DIR/gomodcache"
export GOTMPDIR="$TOOLCHAIN_DIR/gotmp"
mkdir -p "$GOTMPDIR"
export GOLANGCI_LINT_CACHE="$TOOLCHAIN_DIR/golangci-lint-cache"
export GOTOOLCHAIN=local
export UV_PYTHON_INSTALL_DIR="$TOOLCHAIN_DIR/python"
export UV_CACHE_DIR="$TOOLCHAIN_DIR/uvcache"
export UV_PYTHON_PREFERENCE=only-managed
if [ -d "$TOOLCHAIN_DIR/jdk/Contents/Home" ]; then
	export JAVA_HOME="$TOOLCHAIN_DIR/jdk/Contents/Home"
else
	export JAVA_HOME="$TOOLCHAIN_DIR/jdk"
fi
export ANDROID_HOME="$TOOLCHAIN_DIR/android-sdk"
export ANDROID_SDK_ROOT="$ANDROID_HOME"
export GRADLE_USER_HOME="$TOOLCHAIN_DIR/gradle"
export PATH="$TOOLCHAIN_DIR/bin:$GOROOT/bin:$GOPATH/bin:$JAVA_HOME/bin:$PATH"
EOF
}

for tool in $requested; do
	if [ -z "$(lookup "$tool")" ]; then
		echo "no pinned $tool for $platform in $lock" >&2
		exit 1
	fi
done

mkdir -p "$bin"
write_activate

if wanted go; then
	set -- $(lookup go)
	ver="$1"; sum="$2"
	fetch_tree go "https://go.dev/dl/go$ver.$os-$arch.tar.gz" "$sum" "$goroot"
fi

if wanted golangci-lint; then
	set -- $(lookup golangci-lint)
	ver="$1"; sum="$2"
	fetch golangci-lint \
		"https://github.com/golangci/golangci-lint/releases/download/v$ver/golangci-lint-$ver-$platform.tar.gz" \
		"$sum" "golangci-lint-$ver-$platform/golangci-lint"
fi

if wanted go-arch-lint; then
	set -- $(lookup go-arch-lint)
	ver="$1"; sum="$2"
	fetch go-arch-lint \
		"https://github.com/fe3dback/go-arch-lint/releases/download/v$ver/go-arch-lint_${ver}_${os}_${arch}.tar.gz" \
		"$sum" "go-arch-lint"
fi

case "$platform" in
	linux-amd64) triple=x86_64-unknown-linux-gnu ;;
	linux-arm64) triple=aarch64-unknown-linux-gnu ;;
	darwin-amd64) triple=x86_64-apple-darwin ;;
	darwin-arm64) triple=aarch64-apple-darwin ;;
esac
if wanted ruff; then
	set -- $(lookup ruff)
	ver="$1"; sum="$2"
	fetch ruff \
		"https://github.com/astral-sh/ruff/releases/download/$ver/ruff-$triple.tar.gz" \
		"$sum" "ruff-$triple/ruff"
fi

if wanted uv; then
	set -- $(lookup uv)
	ver="$1"; sum="$2"
	fetch uv \
		"https://github.com/astral-sh/uv/releases/download/$ver/uv-$triple.tar.gz" \
		"$sum" "uv-$triple/uv"
fi

case "$platform" in
	linux-amd64) mado_os=Linux-gnu; mado_arch=x86_64 ;;
	linux-arm64) mado_os=Linux-gnu; mado_arch=arm64 ;;
	darwin-amd64) mado_os=macOS; mado_arch=x86_64 ;;
	darwin-arm64) mado_os=macOS; mado_arch=arm64 ;;
esac
if wanted mado; then
	set -- $(lookup mado)
	ver="$1"; sum="$2"
	fetch mado \
		"https://github.com/akiomik/mado/releases/download/v$ver/mado-$mado_os-$mado_arch.tar.gz" \
		"$sum" "mado"
fi

# esbuild and Biome publish their release binaries as npm package archives.
case "$arch" in
	amd64) npm_arch=x64 ;;
	arm64) npm_arch=arm64 ;;
esac
npm_platform="$os-$npm_arch"
if wanted esbuild; then
	set -- $(lookup esbuild)
	ver="$1"; sum="$2"
	fetch esbuild \
		"https://registry.npmjs.org/@esbuild/$npm_platform/-/$npm_platform-$ver.tgz" \
		"$sum" "package/bin/esbuild"
fi

if wanted biome; then
	set -- $(lookup biome)
	ver="$1"; sum="$2"
	fetch biome \
		"https://registry.npmjs.org/@biomejs/cli-$npm_platform/-/cli-$npm_platform-$ver.tgz" \
		"$sum" "package/biome"
fi

case "$platform" in
	linux-amd64) zig_platform=x86_64-linux ;;
	linux-arm64) zig_platform=aarch64-linux ;;
	darwin-amd64) zig_platform=x86_64-macos ;;
	darwin-arm64) zig_platform=aarch64-macos ;;
esac
if wanted zig; then
	set -- $(lookup zig)
	ver="$1"; sum="$2"
	fetch_tree zig "https://ziglang.org/download/$ver/zig-$zig_platform-$ver.tar.xz" "$sum" "$toolchain/zig"
	ln -sf ../zig/zig "$bin/zig"
fi

case "$platform" in
	linux-amd64) jdk_platform=x64_linux ;;
	darwin-amd64) jdk_platform=x64_mac ;;
	darwin-arm64) jdk_platform=aarch64_mac ;;
esac
if wanted jdk; then
	set -- $(lookup jdk)
	ver="$1"; sum="$2"
	major=${ver%%.*}
	release=$(printf '%s' "$ver" | sed 's/+/%2B/')
	file_version=$(printf '%s' "$ver" | tr '+' '_')
	fetch_tree jdk \
		"https://github.com/adoptium/temurin$major-binaries/releases/download/jdk-$release/OpenJDK${major}U-jdk_${jdk_platform}_hotspot_$file_version.tar.gz" \
		"$sum" "$toolchain/jdk"
fi

# Each Android SDK package is one archive from Google's repository, pinned by its
# SHA-256 like every other tool. Its single top directory becomes the package
# directory that the Android build looks for under ANDROID_HOME.
fetch_sdk_package() {
	tool="$1"; archive="$2"; want="$3"; package_dir="$4"
	tmp=$(mktemp -d)
	trap 'rm -rf "$tmp"' EXIT
	echo "==> $tool $platform"
	curl -fsSL "https://dl.google.com/android/repository/$archive" -o "$tmp/archive.zip"
	got=$(sha256 "$tmp/archive.zip")
	if [ "$got" != "$want" ]; then
		echo "checksum mismatch for $tool: expected $want, got $got" >&2
		exit 1
	fi
	mkdir "$tmp/tree"
	unzip -q "$tmp/archive.zip" -d "$tmp/tree"
	rm -rf "$package_dir"
	mkdir -p "$(dirname "$package_dir")"
	mv "$tmp/tree/"* "$package_dir"
	rm -rf "$tmp"
	trap - EXIT
}

# A platform with a minor API level, such as 37.0, needs the package.xml that sdkmanager
# writes. It restates the source.properties of the archive.
write_platform_package_xml() {
	package_dir="$1"
	property() { sed -n "s/^$1=//p" "$package_dir/source.properties"; }
	api_level=$(property AndroidVersion.ApiLevel)
	cat > "$package_dir/package.xml" <<EOF
<?xml version="1.0" encoding="UTF-8"?>
<ns2:repository xmlns:ns2="http://schemas.android.com/repository/android/common/02" xmlns:ns6="http://schemas.android.com/sdk/android/repo/repository2/04">
  <localPackage path="platforms;android-$api_level" obsolete="false">
    <type-details xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:type="ns6:platformDetailsType">
      <api-level>$api_level</api-level>
      <codename></codename>
      <extension-level>$(property AndroidVersion.ExtensionLevel)</extension-level>
      <base-extension>$(property AndroidVersion.IsBaseSdk)</base-extension>
      <layoutlib api="$(property Layoutlib.Api)" />
    </type-details>
    <revision>
      <major>$(property Pkg.Revision)</major>
    </revision>
    <display-name>Android SDK Platform $api_level</display-name>
  </localPackage>
</ns2:repository>
EOF
}

sdk="$toolchain/android-sdk"
for tool in android-platform android-build-tools android-platform-tools android-ndk; do
	wanted "$tool" || continue
	set -- $(lookup "$tool")
	ver="$1"; sum="$2"; archive="$3"
	case "$tool" in
		android-platform) package_dir="$sdk/platforms/android-$ver" ;;
		android-build-tools) package_dir="$sdk/build-tools/$ver" ;;
		android-platform-tools) package_dir="$sdk/platform-tools" ;;
		android-ndk) package_dir="$sdk/ndk/$ver" ;;
	esac
	fetch_sdk_package "$tool" "$archive" "$sum" "$package_dir"
	if [ "$tool" = android-platform ]; then write_platform_package_xml "$package_dir"; fi
done

# Gradle comes from the wrapper of the Android app, which pins it by checksum. The
# settings of tools/gradle.properties apply to every Gradle build of the toolchain.
case " $groups " in *" android "*)
	echo "==> gradle"
	mkdir -p "$toolchain/gradle"
	cp "$root/tools/gradle.properties" "$toolchain/gradle/gradle.properties"
	java_home="$toolchain/jdk"
	if [ -d "$java_home/Contents/Home" ]; then java_home="$java_home/Contents/Home"; fi
	JAVA_HOME="$java_home" GRADLE_USER_HOME="$toolchain/gradle" \
		"$root/distributions/yacypeercompanion/gradlew" -p "$root/distributions/yacypeercompanion" --version --quiet > /dev/null
	;;
esac

for group in $groups; do pins > "$toolchain/installed-$group.lock"; done
