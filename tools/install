#!/bin/sh
# Download the pinned tools from their official releases into .toolchain,
# verifying each archive against tools/tools.lock.
# No `go install` / `go tool`: nothing is compiled and the project module
# graph is untouched.
set -eu

root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
lock="$root/tools/tools.lock"
toolchain="$root/.toolchain"
bin="$toolchain/bin"
goroot="$toolchain/go"
protoc_include="$toolchain/include"

case "$(uname -s)" in
	Linux) os=linux ;;
	Darwin) os=darwin ;;
	*) echo "unsupported OS: $(uname -s)" >&2; exit 1 ;;
esac
case "$(uname -m)" in
	x86_64 | amd64) arch=amd64 ;;
	aarch64 | arm64) arch=arm64 ;;
	*) echo "unsupported architecture: $(uname -m)" >&2; exit 1 ;;
esac
platform="$os-$arch"

lookup() {
	awk -v tool="$1" -v plat="$platform" \
		'$1 == tool && $3 == plat { print $2, $4 }' "$lock"
}

sha256() {
	if command -v sha256sum >/dev/null 2>&1; then
		sha256sum "$1" | cut -d' ' -f1
	else
		shasum -a 256 "$1" | cut -d' ' -f1
	fi
}

fetch() {
	tool="$1"; url="$2"; want="$3"; member="$4"
	tmp=$(mktemp -d)
	trap 'rm -rf "$tmp"' EXIT
	echo "==> $tool $platform"
	curl -fsSL "$url" -o "$tmp/archive.tar.gz"
	got=$(sha256 "$tmp/archive.tar.gz")
	if [ "$got" != "$want" ]; then
		echo "checksum mismatch for $tool: expected $want, got $got" >&2
		exit 1
	fi
	tar -xzf "$tmp/archive.tar.gz" -C "$tmp"
	install -m 0755 "$tmp/$member" "$bin/$tool"
	rm -rf "$tmp"
	trap - EXIT
}

# The Go toolchain is a tree, not one binary; the archive carries it under go/
# and GOROOT is that tree at .toolchain/go.
fetch_go() {
	url="$1"; want="$2"
	tmp=$(mktemp -d)
	trap 'rm -rf "$tmp"' EXIT
	echo "==> go $platform"
	curl -fsSL "$url" -o "$tmp/archive.tar.gz"
	got=$(sha256 "$tmp/archive.tar.gz")
	if [ "$got" != "$want" ]; then
		echo "checksum mismatch for go: expected $want, got $got" >&2
		exit 1
	fi
	rm -rf "$goroot"
	mkdir -p "$goroot"
	tar -xzf "$tmp/archive.tar.gz" -C "$goroot" --strip-components=1
	rm -rf "$tmp"
	trap - EXIT
}

# protoc needs its bundled well-known type definitions, such as
# google/protobuf/timestamp.proto, on the proto path; the release zip carries them
# beside the binary and one checksum covers both.
fetch_protoc() {
	url="$1"; want="$2"
	tmp=$(mktemp -d)
	trap 'rm -rf "$tmp"' EXIT
	echo "==> protoc $platform"
	curl -fsSL "$url" -o "$tmp/archive.zip"
	got=$(sha256 "$tmp/archive.zip")
	if [ "$got" != "$want" ]; then
		echo "checksum mismatch for protoc: expected $want, got $got" >&2
		exit 1
	fi
	unzip -q -o "$tmp/archive.zip" -d "$tmp"
	install -m 0755 "$tmp/bin/protoc" "$bin/protoc"
	rm -rf "$protoc_include"
	mkdir -p "$protoc_include"
	cp -R "$tmp/include/." "$protoc_include/"
	rm -rf "$tmp"
	trap - EXIT
}

# Shells reach the toolchain through `. .toolchain/activate`, which points GOROOT
# at the pinned tree and keeps every cache inside .toolchain.
write_activate() {
	cat > "$toolchain/activate" <<'EOF'
# Source this: . .toolchain/activate
TOOLCHAIN_DIR="$(cd "$(dirname "${BASH_SOURCE[0]:-$0}")" && pwd)"
export GOROOT="$TOOLCHAIN_DIR/go"
export GOPATH="$TOOLCHAIN_DIR/gopath"
export GOCACHE="$TOOLCHAIN_DIR/gocache"
export GOMODCACHE="$TOOLCHAIN_DIR/gomodcache"
export GOTMPDIR="$TOOLCHAIN_DIR/gotmp"
export GOLANGCI_LINT_CACHE="$TOOLCHAIN_DIR/golangci-lint-cache"
export GOTOOLCHAIN=local
export PATH="$TOOLCHAIN_DIR/bin:$GOROOT/bin:$GOPATH/bin:$PATH"
EOF
}

mkdir -p "$bin" "$toolchain/gotmp"
write_activate

set -- $(lookup go)
ver="$1"; sum="$2"
fetch_go "https://go.dev/dl/go$ver.$os-$arch.tar.gz" "$sum"

set -- $(lookup golangci-lint)
ver="$1"; sum="$2"
fetch golangci-lint \
	"https://github.com/golangci/golangci-lint/releases/download/v$ver/golangci-lint-$ver-$platform.tar.gz" \
	"$sum" "golangci-lint-$ver-$platform/golangci-lint"

set -- $(lookup go-arch-lint)
ver="$1"; sum="$2"
fetch go-arch-lint \
	"https://github.com/fe3dback/go-arch-lint/releases/download/v$ver/go-arch-lint_${ver}_${os}_${arch}.tar.gz" \
	"$sum" "go-arch-lint"

case "$platform" in
	linux-amd64) triple=x86_64-unknown-linux-gnu ;;
	linux-arm64) triple=aarch64-unknown-linux-gnu ;;
	darwin-amd64) triple=x86_64-apple-darwin ;;
	darwin-arm64) triple=aarch64-apple-darwin ;;
esac
set -- $(lookup ruff)
ver="$1"; sum="$2"
fetch ruff \
	"https://github.com/astral-sh/ruff/releases/download/$ver/ruff-$triple.tar.gz" \
	"$sum" "ruff-$triple/ruff"

case "$platform" in
	linux-amd64) mado_os=Linux-gnu; mado_arch=x86_64 ;;
	linux-arm64) mado_os=Linux-gnu; mado_arch=arm64 ;;
	darwin-amd64) mado_os=macOS; mado_arch=x86_64 ;;
	darwin-arm64) mado_os=macOS; mado_arch=arm64 ;;
esac
set -- $(lookup mado)
ver="$1"; sum="$2"
fetch mado \
	"https://github.com/akiomik/mado/releases/download/v$ver/mado-$mado_os-$mado_arch.tar.gz" \
	"$sum" "mado"

case "$platform" in
	linux-amd64) protoc_plat=linux-x86_64 ;;
	linux-arm64) protoc_plat=linux-aarch_64 ;;
	darwin-amd64) protoc_plat=osx-x86_64 ;;
	darwin-arm64) protoc_plat=osx-aarch_64 ;;
esac
set -- $(lookup protoc)
ver="$1"; sum="$2"
fetch_protoc \
	"https://github.com/protocolbuffers/protobuf/releases/download/v$ver/protoc-$ver-$protoc_plat.zip" \
	"$sum"

set -- $(lookup protoc-gen-go)
ver="$1"; sum="$2"
fetch protoc-gen-go \
	"https://github.com/protocolbuffers/protobuf-go/releases/download/v$ver/protoc-gen-go.v$ver.$os.$arch.tar.gz" \
	"$sum" "protoc-gen-go"

set -- $(lookup protoc-gen-go-grpc)
ver="$1"; sum="$2"
fetch protoc-gen-go-grpc \
	"https://github.com/grpc/grpc-go/releases/download/cmd%2Fprotoc-gen-go-grpc%2Fv$ver/protoc-gen-go-grpc.v$ver.$os.$arch.tar.gz" \
	"$sum" "protoc-gen-go-grpc"
