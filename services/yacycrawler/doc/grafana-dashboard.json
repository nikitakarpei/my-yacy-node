{
  "title": "yacycrawler",
  "uid": "yacycrawler",
  "editable": true,
  "schemaVersion": 39,
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "refresh": "15s",
  "templating": {
    "list": [
      {
        "name": "datasource",
        "type": "datasource",
        "query": "prometheus",
        "current": {},
        "hide": 0
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "Crawler health",
      "type": "row",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "panels": []
    },
    {
      "id": 3,
      "title": "Order failure share (5m)",
      "description": "This panel shows the percent of received orders that failed in the same time window.",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 4,
        "w": 8,
        "x": 0,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "value": null,
                "color": "green"
              },
              {
                "value": 0.05,
                "color": "yellow"
              },
              {
                "value": 0.2,
                "color": "red"
              }
            ]
          }
        }
      },
      "options": {
        "graphMode": "area",
        "colorMode": "value",
        "justifyMode": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(yacycrawler_orders_returned_total[5m])) / sum(rate(yacycrawler_orders_received_total[5m]))"
        }
      ]
    },
    {
      "id": 4,
      "title": "Fetch latency (p99)",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 4,
        "w": 8,
        "x": 8,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "value": null,
                "color": "green"
              }
            ]
          }
        }
      },
      "options": {
        "graphMode": "area",
        "colorMode": "value",
        "justifyMode": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.99, sum by (le) (rate(yacycrawler_fetch_duration_seconds_bucket[$__rate_interval])))"
        }
      ]
    },
    {
      "id": 10,
      "title": "Order flow",
      "type": "row",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 5
      },
      "panels": []
    },
    {
      "id": 11,
      "title": "Order throughput",
      "description": "This panel counts receipts, acceptances, and returns as separate events.",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 6
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "custom": {
            "fillOpacity": 10
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "returned"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "red"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(yacycrawler_orders_received_total[$__rate_interval]))",
          "legendFormat": "received"
        },
        {
          "refId": "B",
          "expr": "sum(rate(yacycrawler_orders_accepted_total[$__rate_interval]))",
          "legendFormat": "accepted"
        },
        {
          "refId": "C",
          "expr": "sum(rate(yacycrawler_orders_returned_total[$__rate_interval]))",
          "legendFormat": "returned"
        }
      ]
    },
    {
      "id": 20,
      "title": "Page fetching",
      "type": "row",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 14
      },
      "panels": []
    },
    {
      "id": 21,
      "title": "Pages fetched",
      "description": "This panel counts fetches that return a page body.",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 15
      },
      "fieldConfig": {
        "defaults": {
          "unit": "cps",
          "custom": {
            "fillOpacity": 10
          }
        }
      },
      "options": {
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(yacycrawler_pages_fetched_total[$__rate_interval]))",
          "legendFormat": "fetched"
        }
      ]
    },
    {
      "id": 22,
      "title": "Fetch latency",
      "description": "This panel shows the p50, p95, and p99 duration of each fetch attempt. It includes unchanged, refused, and failed responses.",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 15
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "fillOpacity": 0
          }
        }
      },
      "options": {
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.50, sum by (le) (rate(yacycrawler_fetch_duration_seconds_bucket[$__rate_interval])))",
          "legendFormat": "p50"
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(yacycrawler_fetch_duration_seconds_bucket[$__rate_interval])))",
          "legendFormat": "p95"
        },
        {
          "refId": "C",
          "expr": "histogram_quantile(0.99, sum by (le) (rate(yacycrawler_fetch_duration_seconds_bucket[$__rate_interval])))",
          "legendFormat": "p99"
        }
      ]
    },
    {
      "id": 23,
      "title": "Refusals honored by target demand",
      "description": "A refusal is a demand from the target. Access refusal and indexing refusal abandon the page, and the crawl continues with the rest of the frontier. Link discovery refusal keeps the page but adds no new URL to the frontier. Deferral puts the page back in the frontier for the wait time the target asks for.",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 23
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "custom": {
            "fillOpacity": 10
          }
        }
      },
      "options": {
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (demand) (rate(yacycrawler_refusals_honored_total[$__rate_interval]))",
          "legendFormat": "{{demand}}"
        }
      ]
    },
    {
      "id": 30,
      "title": "Scrape request publication",
      "type": "row",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 31
      },
      "panels": []
    },
    {
      "id": 31,
      "title": "Scrape requests published",
      "description": "This panel counts each scrape request the crawler sends for a fetched page.",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 32
      },
      "fieldConfig": {
        "defaults": {
          "unit": "cps",
          "custom": {
            "fillOpacity": 10,
            "drawStyle": "line",
            "showPoints": "auto"
          }
        }
      },
      "options": {
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(yacycrawler_scrape_requests_published_total[$__rate_interval]))",
          "legendFormat": "published"
        }
      ]
    },
    {
      "id": 34,
      "title": "Page disposal",
      "type": "row",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 40
      },
      "panels": []
    },
    {
      "id": 32,
      "title": "Pages disposed by reason",
      "description": "Disposal is the final outcome for a page that the crawler does not publish. The reasons not-due and host-pages-spent occur before the crawler fetches the page.",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 41
      },
      "fieldConfig": {
        "defaults": {
          "unit": "cps",
          "custom": {
            "fillOpacity": 10,
            "drawStyle": "line",
            "showPoints": "auto"
          }
        }
      },
      "options": {
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (reason) (rate(yacycrawler_pages_disposed_total[$__rate_interval]))",
          "legendFormat": "{{reason}}"
        }
      ]
    }
  ]
}
