{
  "title": "yacycrawler",
  "uid": "yacycrawler",
  "editable": true,
  "schemaVersion": 39,
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "refresh": "15s",
  "graphTooltip": 1,
  "templating": {
    "list": [
      {
        "name": "datasource",
        "type": "datasource",
        "query": "prometheus",
        "current": {},
        "hide": 0
      },
      {
        "name": "service_instance",
        "label": "Process instance",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "query": {
          "query": "label_values(yacycrawler_info, instance)",
          "refId": "service-instance-variable"
        },
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "includeAll": true,
        "allValue": ".*",
        "multi": true,
        "refresh": 1,
        "sort": 1
      }
    ]
  },
  "panels": [
    {
      "id": 10,
      "title": "Order flow",
      "type": "row",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "panels": []
    },
    {
      "id": 11,
      "title": "Orders accepted and returned",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "fillOpacity": 10,
            "drawStyle": "line",
            "showPoints": "auto"
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "returned"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "red"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (outcome) (increase(yacycrawler_crawl_orders_processed_total{instance=~\"$service_instance\"}[$__rate_interval]))",
          "legendFormat": "{{outcome}}"
        }
      ]
    },
    {
      "id": 40,
      "title": "Frontier",
      "type": "row",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 9
      },
      "panels": []
    },
    {
      "id": 41,
      "title": "Page visit attempts, by outcome",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 16,
        "x": 0,
        "y": 10
      },
      "fieldConfig": {
        "defaults": {
          "unit": "cps",
          "custom": {
            "fillOpacity": 10,
            "drawStyle": "line",
            "showPoints": "auto"
          }
        }
      },
      "options": {
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (outcome) (rate(yacycrawler_page_visit_attempts_total{instance=~\"$service_instance\"}[$__rate_interval]))",
          "legendFormat": "{{outcome}}"
        }
      ]
    },
    {
      "id": 42,
      "title": "Page visit history failures",
      "description": "Failures to read or update page visit history. A read failure can cause an extra fetch now. A write failure can allow an extra fetch later.",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 16,
        "y": 10
      },
      "fieldConfig": {
        "defaults": {
          "unit": "cps",
          "custom": {
            "fillOpacity": 10,
            "drawStyle": "line",
            "showPoints": "auto"
          }
        }
      },
      "options": {
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(yacycrawler_page_visits_not_recorded_total{instance=~\"$service_instance\"}[$__rate_interval]))",
          "legendFormat": "write failures"
        },
        {
          "refId": "B",
          "expr": "sum(rate(yacycrawler_last_page_visits_not_read_total{instance=~\"$service_instance\"}[$__rate_interval]))",
          "legendFormat": "read failures"
        }
      ]
    },
    {
      "id": 32,
      "title": "Pages disposed, by reason",
      "description": "A disposed page is one the crawler ended without publishing.",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 18
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "fillOpacity": 10,
            "drawStyle": "line",
            "showPoints": "auto"
          }
        }
      },
      "options": {
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (reason) (increase(yacycrawler_pages_disposed_total{instance=~\"$service_instance\"}[$__rate_interval]))",
          "legendFormat": "{{reason}}"
        }
      ]
    },
    {
      "id": 20,
      "title": "Page fetching",
      "type": "row",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 26
      },
      "panels": []
    },
    {
      "id": 21,
      "title": "Page fetches, by outcome",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 27
      },
      "fieldConfig": {
        "defaults": {
          "unit": "cps",
          "custom": {
            "fillOpacity": 10,
            "drawStyle": "line",
            "showPoints": "auto"
          }
        }
      },
      "options": {
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (outcome) (rate(yacycrawler_page_fetches_processed_total{instance=~\"$service_instance\"}[$__rate_interval]))",
          "legendFormat": "{{outcome}}"
        }
      ]
    },
    {
      "id": 22,
      "title": "Fetch attempt latency (p50/p95/p99)",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 27
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "fillOpacity": 10,
            "drawStyle": "line",
            "showPoints": "auto"
          }
        }
      },
      "options": {
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.50, sum by (le) (rate(yacycrawler_page_fetch_duration_seconds_bucket{instance=~\"$service_instance\"}[$__rate_interval])))",
          "legendFormat": "p50"
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(yacycrawler_page_fetch_duration_seconds_bucket{instance=~\"$service_instance\"}[$__rate_interval])))",
          "legendFormat": "p95"
        },
        {
          "refId": "C",
          "expr": "histogram_quantile(0.99, sum by (le) (rate(yacycrawler_page_fetch_duration_seconds_bucket{instance=~\"$service_instance\"}[$__rate_interval])))",
          "legendFormat": "p99"
        }
      ]
    },
    {
      "id": 50,
      "title": "Page reading",
      "type": "row",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 35
      },
      "panels": []
    },
    {
      "id": 51,
      "title": "Page media types not parsed",
      "description": "The crawler reads the media type up to the first semicolon instead, to tell whether the page is HTML.",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 36
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "fillOpacity": 10,
            "drawStyle": "line",
            "showPoints": "auto"
          }
        }
      },
      "options": {
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(increase(yacycrawler_page_media_types_unparsed_total{instance=~\"$service_instance\"}[$__rate_interval]))",
          "legendFormat": "not parsed"
        }
      ]
    },
    {
      "id": 23,
      "title": "Link discovery refusals enforced",
      "description": "The page told the crawler not to follow its links, so none of them reach the frontier.",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 36
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "fillOpacity": 10,
            "drawStyle": "line",
            "showPoints": "auto"
          }
        }
      },
      "options": {
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(increase(yacycrawler_link_discovery_refusals_enforced_total{instance=~\"$service_instance\"}[$__rate_interval]))",
          "legendFormat": "enforced"
        }
      ]
    },
    {
      "id": 52,
      "title": "Base URLs not resolved",
      "description": "A page can state the URL its links are relative to. When the crawler cannot resolve that URL, it uses the page URL instead.",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 44
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "fillOpacity": 10,
            "drawStyle": "line",
            "showPoints": "auto"
          }
        }
      },
      "options": {
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(increase(yacycrawler_page_base_urls_unresolved_total{instance=~\"$service_instance\"}[$__rate_interval]))",
          "legendFormat": "not resolved"
        }
      ]
    },
    {
      "id": 53,
      "title": "Links not resolved",
      "description": "A link the crawler cannot resolve into a URL never reaches the frontier, so the page behind it stays uncrawled.",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 44
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "fillOpacity": 10,
            "drawStyle": "line",
            "showPoints": "auto"
          }
        }
      },
      "options": {
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(increase(yacycrawler_page_links_unresolved_total{instance=~\"$service_instance\"}[$__rate_interval]))",
          "legendFormat": "not resolved"
        }
      ]
    },
    {
      "id": 30,
      "title": "Crawled pages",
      "type": "row",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 52
      },
      "panels": []
    },
    {
      "id": 31,
      "title": "Crawled pages, by indexing",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 53
      },
      "fieldConfig": {
        "defaults": {
          "unit": "cps",
          "custom": {
            "fillOpacity": 10,
            "drawStyle": "line",
            "showPoints": "auto"
          }
        }
      },
      "options": {
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (indexing) (rate(yacycrawler_crawled_pages_total{instance=~\"$service_instance\"}[$__rate_interval]))",
          "legendFormat": "{{indexing}}"
        }
      ]
    },
    {
      "id": 35,
      "title": "Crawled page publications, by outcome",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 53
      },
      "fieldConfig": {
        "defaults": {
          "unit": "cps",
          "custom": {
            "fillOpacity": 10,
            "drawStyle": "line",
            "showPoints": "auto"
          }
        }
      },
      "options": {
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (outcome) (rate(yacycrawler_crawled_page_publications_total{instance=~\"$service_instance\"}[$__rate_interval]))",
          "legendFormat": "{{outcome}}"
        }
      ]
    },
    {
      "id": 100,
      "title": "Go process",
      "type": "row",
      "gridPos": {"h": 1, "w": 24, "x": 0, "y": 61},
      "panels": []
    },
    {
      "id": 101,
      "title": "Process memory",
      "type": "timeseries",
      "datasource": {"type": "prometheus", "uid": "${datasource}"},
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 62},
      "fieldConfig": {"defaults": {"unit": "bytes", "custom": {"drawStyle": "line", "fillOpacity": 10, "showPoints": "auto"}}},
      "options": {"tooltip": {"mode": "multi"}},
      "targets": [
        {"refId": "A", "expr": "process_resident_memory_bytes{instance=~\"$service_instance\"} and on (job, instance) yacycrawler_info{instance=~\"$service_instance\"}", "legendFormat": "{{instance}} resident"},
        {"refId": "B", "expr": "go_memstats_heap_alloc_bytes{instance=~\"$service_instance\"} and on (job, instance) yacycrawler_info{instance=~\"$service_instance\"}", "legendFormat": "{{instance}} heap allocated"},
        {"refId": "C", "expr": "go_memstats_heap_inuse_bytes{instance=~\"$service_instance\"} and on (job, instance) yacycrawler_info{instance=~\"$service_instance\"}", "legendFormat": "{{instance}} heap in use"}
      ]
    },
    {
      "id": 102,
      "title": "CPU cores used",
      "type": "timeseries",
      "datasource": {"type": "prometheus", "uid": "${datasource}"},
      "gridPos": {"h": 8, "w": 6, "x": 12, "y": 62},
      "fieldConfig": {"defaults": {"unit": "short", "custom": {"drawStyle": "line", "fillOpacity": 10, "showPoints": "auto"}}},
      "options": {"tooltip": {"mode": "multi"}},
      "targets": [
        {"refId": "A", "expr": "rate(process_cpu_seconds_total{instance=~\"$service_instance\"}[$__rate_interval]) and on (job, instance) yacycrawler_info{instance=~\"$service_instance\"}", "legendFormat": "{{instance}}"}
      ]
    },
    {
      "id": 103,
      "title": "Goroutines",
      "type": "timeseries",
      "datasource": {"type": "prometheus", "uid": "${datasource}"},
      "gridPos": {"h": 8, "w": 6, "x": 18, "y": 62},
      "fieldConfig": {"defaults": {"unit": "short", "custom": {"drawStyle": "line", "fillOpacity": 10, "showPoints": "auto"}}},
      "options": {"tooltip": {"mode": "multi"}},
      "targets": [
        {"refId": "A", "expr": "go_goroutines{instance=~\"$service_instance\"} and on (job, instance) yacycrawler_info{instance=~\"$service_instance\"}", "legendFormat": "{{instance}}"}
      ]
    },
    {
      "id": 104,
      "title": "Garbage collection rate",
      "type": "timeseries",
      "datasource": {"type": "prometheus", "uid": "${datasource}"},
      "gridPos": {"h": 8, "w": 8, "x": 0, "y": 70},
      "fieldConfig": {"defaults": {"unit": "cps", "custom": {"drawStyle": "line", "fillOpacity": 10, "showPoints": "auto"}}},
      "options": {"tooltip": {"mode": "multi"}},
      "targets": [
        {"refId": "A", "expr": "rate(go_gc_duration_seconds_count{instance=~\"$service_instance\"}[$__rate_interval]) and on (job, instance) yacycrawler_info{instance=~\"$service_instance\"}", "legendFormat": "{{instance}}"}
      ]
    },
    {
      "id": 105,
      "title": "Share of time paused for garbage collection",
      "type": "timeseries",
      "datasource": {"type": "prometheus", "uid": "${datasource}"},
      "gridPos": {"h": 8, "w": 8, "x": 8, "y": 70},
      "fieldConfig": {"defaults": {"unit": "percentunit", "min": 0, "custom": {"drawStyle": "line", "fillOpacity": 10, "showPoints": "auto"}}},
      "options": {"tooltip": {"mode": "multi"}},
      "targets": [
        {"refId": "A", "expr": "rate(go_gc_duration_seconds_sum{instance=~\"$service_instance\"}[$__rate_interval]) and on (job, instance) yacycrawler_info{instance=~\"$service_instance\"}", "legendFormat": "{{instance}}"}
      ]
    },
    {
      "id": 106,
      "title": "Share of file descriptor capacity used",
      "type": "timeseries",
      "datasource": {"type": "prometheus", "uid": "${datasource}"},
      "gridPos": {"h": 8, "w": 8, "x": 16, "y": 70},
      "fieldConfig": {"defaults": {"unit": "percentunit", "min": 0, "max": 1, "custom": {"drawStyle": "line", "fillOpacity": 10, "showPoints": "auto"}}},
      "options": {"tooltip": {"mode": "multi"}},
      "targets": [
        {"refId": "A", "expr": "(process_open_fds{instance=~\"$service_instance\"} / process_max_fds{instance=~\"$service_instance\"}) and on (job, instance) yacycrawler_info{instance=~\"$service_instance\"}", "legendFormat": "{{instance}}"}
      ]
    }
  ]
}
