        {
          "refId": "A",
          "expr": "sum by (le) (clamp_min(yacydhtsearch_word_joined_search_duration_seconds_bucket{instance=~\"$service_instance\"} - (yacydhtsearch_word_joined_search_duration_seconds_bucket{instance=~\"$service_instance\"} offset $__interval), 0))",
          "format": "heatmap",
          "legendFormat": "{{le}}"
        }
      ]
    },
    {
      "id": 71,
      "title": "Share of searches no document held all query words for",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
