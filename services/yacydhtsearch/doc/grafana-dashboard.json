        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (le) (clamp_min(yacydhtsearch_peer_matched_search_duration_seconds_bucket{instance=~\"$service_instance\"} - (yacydhtsearch_peer_matched_search_duration_seconds_bucket{instance=~\"$service_instance\"} offset $__interval), 0))",
          "format": "heatmap",
          "legendFormat": "{{le}}"
        }
      ]
    },
    {
      "id": 53,
      "title": "Share of asked peers that answered",
      "type": "heatmap",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 61
      },
      "interval": "$window",
      "options": {
        "calculate": false,
        "cellGap": 1,
        "color": {
          "mode": "scheme",
          "scheme": "Viridis",
          "steps": 64,
          "exponent": 0.5,
          "reverse": false,
          "min": 0
        },
        "yAxis": {
          "unit": "percentunit",
          "axisPlacement": "left"
        },
        "legend": {
          "show": true
        },
        "tooltip": {
          "mode": "single",
          "yHistogram": true
        },
        "exemplars": {
          "color": "rgba(255,0,255,0.7)"
        },
        "filterValues": {
