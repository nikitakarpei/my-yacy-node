{
  "title": "spamproxy",
  "uid": "spamproxy",
  "editable": true,
  "schemaVersion": 39,
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "refresh": "30s",
  "graphTooltip": 1,
  "templating": {
    "list": [
      {
        "name": "datasource",
        "type": "datasource",
        "query": "prometheus",
        "current": {},
        "hide": 0
      },
      {
        "name": "service_instance",
        "label": "Process instance",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "query": {
          "query": "label_values(spamproxy_info, instance)",
          "refId": "service-instance-variable"
        },
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "includeAll": true,
        "allValue": ".*",
        "multi": true,
        "refresh": 1,
        "sort": 1
      },
      {
        "name": "window",
        "label": "Smoothing window",
        "type": "interval",
        "query": "30s,1m,2m,5m,10m,30m,1h,6h,12h,1d",
        "options": [
          {
            "text": "auto",
            "value": "$__auto_interval_window",
            "selected": true
          },
          {
            "text": "30s",
            "value": "30s",
            "selected": false
          },
          {
            "text": "1m",
            "value": "1m",
            "selected": false
          },
          {
            "text": "2m",
            "value": "2m",
            "selected": false
          },
          {
            "text": "5m",
            "value": "5m",
            "selected": false
          },
          {
            "text": "10m",
            "value": "10m",
            "selected": false
          },
          {
            "text": "30m",
            "value": "30m",
            "selected": false
          },
          {
            "text": "1h",
            "value": "1h",
            "selected": false
          },
          {
            "text": "6h",
            "value": "6h",
            "selected": false
          },
          {
            "text": "12h",
            "value": "12h",
            "selected": false
          },
          {
            "text": "1d",
            "value": "1d",
            "selected": false
          }
        ],
        "auto": true,
        "auto_count": 60,
        "auto_min": "30s",
        "current": {
          "text": "auto",
          "value": "$__auto_interval_window",
          "selected": true
        },
        "refresh": 2,
        "hide": 0
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "Replies to proxied requests",
      "type": "row",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "panels": []
    },
    {
      "id": 2,
      "title": "Replies, by kind",
      "description": "Each reply counts once, when spamproxy sends its response headers.",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 70,
            "axisLabel": "per interval",
            "stacking": {
              "mode": "normal"
            }
          },
          "min": 0
        },
        "overrides": []
      },
      "interval": "$window",
      "options": {
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (reply) (clamp_min(spamproxy_response_header_duration_seconds_count{instance=~\"$service_instance\"} - (spamproxy_response_header_duration_seconds_count{instance=~\"$service_instance\"} offset $__interval), 0))",
          "legendFormat": "{{reply}}"
        }
      ]
    },
    {
      "id": 3,
      "title": "Refused requests, by reason",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 8,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 70,
            "axisLabel": "per interval",
            "stacking": {
              "mode": "normal"
            }
          },
          "min": 0
        },
        "overrides": []
      },
      "interval": "$window",
      "options": {
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (reason) (clamp_min(spamproxy_refused_requests_total{instance=~\"$service_instance\"} - (spamproxy_refused_requests_total{instance=~\"$service_instance\"} offset $__interval), 0))",
          "legendFormat": "{{reason}}"
        }
      ]
    },
    {
      "id": 4,
      "title": "Skipped assessments, by reason",
      "description": "A skipped answer goes to the client without a verdict.",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 16,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 70,
            "axisLabel": "per interval",
            "stacking": {
              "mode": "normal"
            }
          },
          "min": 0
        },
        "overrides": []
      },
      "interval": "$window",
      "options": {
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (reason) (clamp_min(spamproxy_skipped_assessments_total{instance=~\"$service_instance\"} - (spamproxy_skipped_assessments_total{instance=~\"$service_instance\"} offset $__interval), 0))",
          "legendFormat": "{{reason}}"
        }
      ]
    },
    {
      "id": 5,
      "title": "How long until the response headers, by kind of reply",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 9
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 0,
            "showPoints": "auto",
            "scaleDistribution": {
              "type": "log",
              "log": 10
            }
          }
        },
        "overrides": []
      },
      "interval": "$window",
      "options": {
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.50, sum by (le, reply) (clamp_min(spamproxy_response_header_duration_seconds_bucket{instance=~\"$service_instance\"} - (spamproxy_response_header_duration_seconds_bucket{instance=~\"$service_instance\"} offset $__interval), 0)))",
          "legendFormat": "{{reply}} p50"
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.90, sum by (le, reply) (clamp_min(spamproxy_response_header_duration_seconds_bucket{instance=~\"$service_instance\"} - (spamproxy_response_header_duration_seconds_bucket{instance=~\"$service_instance\"} offset $__interval), 0)))",
          "legendFormat": "{{reply}} p90"
        },
        {
          "refId": "C",
          "expr": "histogram_quantile(0.99, sum by (le, reply) (clamp_min(spamproxy_response_header_duration_seconds_bucket{instance=~\"$service_instance\"} - (spamproxy_response_header_duration_seconds_bucket{instance=~\"$service_instance\"} offset $__interval), 0)))",
          "legendFormat": "{{reply}} p99"
        }
      ]
    },
    {
      "id": 6,
      "title": "Page bodies read and relayed",
      "type": "row",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 17
      },
      "panels": []
    },
    {
      "id": 7,
      "title": "How long a page waited for a reading slot",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 18
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 0,
            "showPoints": "auto",
            "scaleDistribution": {
              "type": "log",
              "log": 10
            }
          }
        },
        "overrides": []
      },
      "interval": "$window",
      "options": {
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.50, sum by (le) (clamp_min(spamproxy_reading_slot_wait_duration_seconds_bucket{instance=~\"$service_instance\"} - (spamproxy_reading_slot_wait_duration_seconds_bucket{instance=~\"$service_instance\"} offset $__interval), 0)))",
          "legendFormat": "p50"
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.90, sum by (le) (clamp_min(spamproxy_reading_slot_wait_duration_seconds_bucket{instance=~\"$service_instance\"} - (spamproxy_reading_slot_wait_duration_seconds_bucket{instance=~\"$service_instance\"} offset $__interval), 0)))",
          "legendFormat": "p90"
        },
        {
          "refId": "C",
          "expr": "histogram_quantile(0.99, sum by (le) (clamp_min(spamproxy_reading_slot_wait_duration_seconds_bucket{instance=~\"$service_instance\"} - (spamproxy_reading_slot_wait_duration_seconds_bucket{instance=~\"$service_instance\"} offset $__interval), 0)))",
          "legendFormat": "p99"
        }
      ]
    },
    {
      "id": 8,
      "title": "Answers that failed, replies cut short, and clients that left",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 18
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 70,
            "axisLabel": "per interval",
            "stacking": {
              "mode": "normal"
            }
          },
          "min": 0
        },
        "overrides": []
      },
      "interval": "$window",
      "options": {
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(clamp_min(spamproxy_answer_reading_failures_total{instance=~\"$service_instance\"} - (spamproxy_answer_reading_failures_total{instance=~\"$service_instance\"} offset $__interval), 0))",
          "legendFormat": "answers that failed"
        },
        {
          "refId": "B",
          "expr": "sum(clamp_min(spamproxy_cut_short_replies_total{instance=~\"$service_instance\"} - (spamproxy_cut_short_replies_total{instance=~\"$service_instance\"} offset $__interval), 0))",
          "legendFormat": "replies cut short"
        },
        {
          "refId": "C",
          "expr": "sum(clamp_min(spamproxy_departed_clients_total{instance=~\"$service_instance\"} - (spamproxy_departed_clients_total{instance=~\"$service_instance\"} offset $__interval), 0))",
          "legendFormat": "clients that left"
        }
      ]
    },
    {
      "id": 9,
      "title": "Pages assessed for spam",
      "type": "row",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 26
      },
      "panels": []
    },
    {
      "id": 10,
      "title": "Share of the assessed pages, by verdict",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 27
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 70,
            "stacking": {
              "mode": "normal"
            }
          },
          "min": 0,
          "max": 1
        },
        "overrides": []
      },
      "interval": "$window",
      "options": {
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (verdict) (clamp_min(spamproxy_verdicts_total{instance=~\"$service_instance\"} - (spamproxy_verdicts_total{instance=~\"$service_instance\"} offset $__interval), 0)) / ignoring(verdict) group_left sum(clamp_min(spamproxy_verdicts_total{instance=~\"$service_instance\"} - (spamproxy_verdicts_total{instance=~\"$service_instance\"} offset $__interval), 0))",
          "legendFormat": "{{verdict}}"
        }
      ]
    },
    {
      "id": 11,
      "title": "Assessed pages, by score",
      "type": "heatmap",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 27
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none"
        },
        "overrides": []
      },
      "interval": "$window",
      "options": {
        "calculate": false,
        "cellGap": 1,
        "color": {
          "mode": "scheme",
          "scheme": "Viridis",
          "steps": 64,
          "exponent": 0.5,
          "reverse": false,
          "min": 0
        },
        "yAxis": {
          "unit": "none",
          "axisPlacement": "left"
        },
        "legend": {
          "show": true
        },
        "tooltip": {
          "mode": "single",
          "yHistogram": true
        },
        "exemplars": {
          "color": "rgba(255,0,255,0.7)"
        },
        "filterValues": {
          "le": 1e-09
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (le) (clamp_min(spamproxy_scores_bucket{instance=~\"$service_instance\"} - (spamproxy_scores_bucket{instance=~\"$service_instance\"} offset $__interval), 0))",
          "format": "heatmap",
          "legendFormat": "{{le}}"
        }
      ]
    },
    {
      "id": 12,
      "title": "How long a page waited for a CPU slot",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 35
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 0,
            "showPoints": "auto",
            "scaleDistribution": {
              "type": "log",
              "log": 10
            }
          }
        },
        "overrides": []
      },
      "interval": "$window",
      "options": {
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.50, sum by (le) (clamp_min(spamproxy_assessment_slot_wait_duration_seconds_bucket{instance=~\"$service_instance\"} - (spamproxy_assessment_slot_wait_duration_seconds_bucket{instance=~\"$service_instance\"} offset $__interval), 0)))",
          "legendFormat": "p50"
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.90, sum by (le) (clamp_min(spamproxy_assessment_slot_wait_duration_seconds_bucket{instance=~\"$service_instance\"} - (spamproxy_assessment_slot_wait_duration_seconds_bucket{instance=~\"$service_instance\"} offset $__interval), 0)))",
          "legendFormat": "p90"
        },
        {
          "refId": "C",
          "expr": "histogram_quantile(0.99, sum by (le) (clamp_min(spamproxy_assessment_slot_wait_duration_seconds_bucket{instance=~\"$service_instance\"} - (spamproxy_assessment_slot_wait_duration_seconds_bucket{instance=~\"$service_instance\"} offset $__interval), 0)))",
          "legendFormat": "p99"
        }
      ]
    },
    {
      "id": 13,
      "title": "How long an assessment took",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 8,
        "y": 35
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 0,
            "showPoints": "auto",
            "scaleDistribution": {
              "type": "log",
              "log": 10
            }
          }
        },
        "overrides": []
      },
      "interval": "$window",
      "options": {
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.50, sum by (le) (clamp_min(spamproxy_assessment_duration_seconds_bucket{instance=~\"$service_instance\"} - (spamproxy_assessment_duration_seconds_bucket{instance=~\"$service_instance\"} offset $__interval), 0)))",
          "legendFormat": "p50"
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.90, sum by (le) (clamp_min(spamproxy_assessment_duration_seconds_bucket{instance=~\"$service_instance\"} - (spamproxy_assessment_duration_seconds_bucket{instance=~\"$service_instance\"} offset $__interval), 0)))",
          "legendFormat": "p90"
        },
        {
          "refId": "C",
          "expr": "histogram_quantile(0.99, sum by (le) (clamp_min(spamproxy_assessment_duration_seconds_bucket{instance=~\"$service_instance\"} - (spamproxy_assessment_duration_seconds_bucket{instance=~\"$service_instance\"} offset $__interval), 0)))",
          "legendFormat": "p99"
        }
      ]
    },
    {
      "id": 14,
      "title": "Assessment panics",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 16,
        "y": 35
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 70,
            "axisLabel": "per interval",
            "stacking": {
              "mode": "normal"
            }
          },
          "min": 0
        },
        "overrides": []
      },
      "interval": "$window",
      "options": {
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(clamp_min(spamproxy_assessment_panics_total{instance=~\"$service_instance\"} - (spamproxy_assessment_panics_total{instance=~\"$service_instance\"} offset $__interval), 0))",
          "legendFormat": "panics"
        }
      ]
    },
    {
      "id": 15,
      "title": "Go process",
      "type": "row",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 43
      },
      "panels": []
    },
    {
      "id": 16,
      "title": "Process memory",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 44
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10,
            "showPoints": "auto"
          },
          "min": 0
        },
        "overrides": []
      },
      "interval": "$window",
      "options": {
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "process_resident_memory_bytes{instance=~\"$service_instance\"} and on (job, instance) spamproxy_info{instance=~\"$service_instance\"}",
          "legendFormat": "{{instance}} resident"
        },
        {
          "refId": "B",
          "expr": "go_memstats_heap_alloc_bytes{instance=~\"$service_instance\"} and on (job, instance) spamproxy_info{instance=~\"$service_instance\"}",
          "legendFormat": "{{instance}} heap allocated"
        },
        {
          "refId": "C",
          "expr": "go_memstats_heap_inuse_bytes{instance=~\"$service_instance\"} and on (job, instance) spamproxy_info{instance=~\"$service_instance\"}",
          "legendFormat": "{{instance}} heap in use"
        }
      ]
    },
    {
      "id": 17,
      "title": "CPU cores used",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 6,
        "x": 12,
        "y": 44
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10,
            "showPoints": "auto"
          },
          "min": 0
        },
        "overrides": []
      },
      "interval": "$window",
      "options": {
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "clamp_min(process_cpu_seconds_total{instance=~\"$service_instance\"} - (process_cpu_seconds_total{instance=~\"$service_instance\"} offset $__interval), 0) / ($__interval_ms / 1000) and on (job, instance) spamproxy_info{instance=~\"$service_instance\"}",
          "legendFormat": "{{instance}}"
        }
      ]
    },
    {
      "id": 18,
      "title": "Goroutines",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 6,
        "x": 18,
        "y": 44
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10,
            "showPoints": "auto"
          },
          "min": 0
        },
        "overrides": []
      },
      "interval": "$window",
      "options": {
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
