#!/bin/sh
# Binds Go packages of the module in the working directory into one Android library with
# gomobile. One library holds every package, because each library carries the Go runtime.
# Usage: bind-go <library file> <Android API level> <NDK version> <package directory>...
set -eu
library="$1"; android_api="$2"; ndk_version="$3"
shift 3
toolchain="$(cd "$(dirname "$0")/../.." && pwd)/.toolchain"
tools="$(dirname "$library")/bin"

export GOROOT="$toolchain/go" GOPATH="$toolchain/gopath" GOCACHE="$toolchain/gocache"
export GOMODCACHE="$toolchain/gomodcache" GOTMPDIR="$toolchain/gotmp" GOTOOLCHAIN=local GOWORK=off
export ANDROID_HOME="$toolchain/android-sdk"
export ANDROID_NDK_HOME="$ANDROID_HOME/ndk/$ndk_version"
export PATH="$tools:$GOROOT/bin:${JAVA_HOME:+$JAVA_HOME/bin:}$PATH"

go build -o "$tools/" golang.org/x/mobile/cmd/gomobile golang.org/x/mobile/cmd/gobind
packages=""
for package in "$@"; do packages="$packages ./$package"; done
# shellcheck disable=SC2086
gomobile bind -target=android/arm64 -androidapi "$android_api" -trimpath "-ldflags=-X=runtime.modinfo= -buildid=" \
	-o "$library" $packages
